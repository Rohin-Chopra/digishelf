{
  "name": "digishelf",
  "private": true,
  "description": "A digital shelf for the movies and TV shows you love.",
  "author": "Rohin Chopra",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  },
  "engines": {
    "node": ">=26"
  }
}
